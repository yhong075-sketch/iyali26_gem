  "after": {
   "PROTEIN_CLASS": "6.3.5.5",
   "metadata_previous_essentiality_curation": "Arginine-specific CPA2/CPA1 heterodimer; no longer interchangeable with URA2.",
   "metadata_reaction_selection": "metadata_reaction_fields_preserve_trna_20260910",
   "metadata_selected_fields": "gpr",
   "metadata_selection_source_sha256": "33c14f0c524197ec732e09ba86c4382d5b21bc25b4bd73b18eba5f452dd7e797",
   "metadata_selection_evidence_status": "User-selected model version; not new validation of chemistry or native gene function",
   "selection_gpr_restore": "SELECTION-CPA-URA2-RESTORE-20261019",
   "selection_gpr_restore_evidence": "EG-GPR-001: R190 is the arginine-specific glutamine-dependent CPSase, a CPA2 (large chain) and CPA1 (small chain) heterodimer. YALI1C33005g = NCBI Gene 2909603 (XP_502204.1), KEGG yli:2909603 (RefSeq name &apos;Carbamoyl-phosphate synthase arginine-specific large chain&apos;), K01955; YALI1D09420g = NCBI Gene 2910891 (XP_502528.3), Swiss-Prot Q6C9Y4 CPA1, KEGG K01956. Heterodimer: S. cerevisiae CPA1 P07258 and CPA2 P03965 (experimental, PubMed 206535, 5856369); Y. lipolytica Q6C9Y4 by similarity to N. crassa P22572. The equation is unchanged and balanced. URA2 (YALI1E11768g) leaves this GPR; its contribution to the free carbamoyl-phosphate pool is unresolved for Yarrowia lipolytica.",
   "selection_gpr_restore_evidence_status": "curated_annotation",
   "selection_gpr_restore_sources": "https://www.kegg.jp/entry/yli:2909603; https://www.kegg.jp/entry/yli:2910891; https://rest.uniprot.org/uniprotkb/Q6C9Y4; https://rest.uniprot.org/uniprotkb/P07258; https://rest.uniprot.org/uniprotkb/P03965"
  }
 },
